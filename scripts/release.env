# Release configuration (sourced by build/publish scripts).
# GitHub repository that hosts releases + the Sparkle appcast, as OWNER/REPO.
GITHUB_REPO="${GITHUB_REPO:-techInnovator1999/Blinko}"
# Keychain account that holds the Sparkle EdDSA private key (scripts use `generate_keys --account`).
SPARKLE_KEY_ACCOUNT="blinko"
