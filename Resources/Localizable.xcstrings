    "Send a crash report? It opens a pre-filled GitHub issue in your browser so you can review it first. Nothing is sent automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Absturzbericht senden? Es öffnet sich ein vorausgefülltes GitHub-Issue in deinem Browser, das du zuerst prüfen kannst. Nichts wird automatisch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar un informe de fallo? Se abrirá un issue de GitHub prellenado en tu navegador para que puedas revisarlo antes. No se envía nada automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer un rapport de plantage ? Un ticket GitHub prérempli s’ouvre dans votre navigateur pour que vous puissiez d’abord le relire. Rien n’est envoyé automatiquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュレポートを送信しますか？ブラウザで記入済みの GitHub Issue が開くので、送信前に内容を確認できます。自動的に送信されることはありません。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کریش رپورٹ بھیجیں؟ یہ آپ کے براؤزر میں ایک پہلے سے بھرا ہوا GitHub issue کھولتا ہے تاکہ آپ پہلے اسے دیکھ سکیں۔ کچھ بھی خودکار طور پر نہیں بھیجا جاتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要发送崩溃报告吗？它会在浏览器中打开一个预先填写的 GitHub 议题，你可以先查看。不会自动发送任何内容。"
          }
        }
      }
    },
