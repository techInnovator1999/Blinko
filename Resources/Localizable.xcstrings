    "Time-synced lyrics from LRCLIB, fetched when a new track starts while lyrics are on screen, and cached on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitsynchrone Liedtexte von LRCLIB, geladen beim Start eines neuen Titels, während Liedtexte angezeigt werden, und auf diesem Mac zwischengespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letras sincronizadas de LRCLIB, obtenidas cuando empieza una nueva canción mientras las letras están en pantalla, y guardadas en caché en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paroles synchronisées de LRCLIB, récupérées quand un nouveau morceau commence alors que les paroles sont affichées, et mises en cache sur ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LRCLIB から取得した時間同期歌詞です。歌詞の表示中に新しいトラックが始まると取得し、この Mac にキャッシュします。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LRCLIB سے وقت کے ساتھ ہم آہنگ گیتوں کے بول، جو اسکرین پر بول ہونے کی صورت میں نیا ٹریک شروع ہونے پر حاصل کیے جاتے ہیں اور اس Mac پر کیش ہوتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 LRCLIB 的时间同步歌词，在屏幕上显示歌词且新曲目开始播放时获取，并缓存在此 Mac 上。"
          }
        }
      }
    },
