    "Make sure ~/.local/bin is on your PATH (e.g. add export PATH=\"$HOME/.local/bin:$PATH\" to ~/.zshrc)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
