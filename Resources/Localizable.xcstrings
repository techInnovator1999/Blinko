        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "微調整により、閉じたアイランドがノッチをぴったり覆います。ディスプレイの解像度をスケーリングしている場合に便利です。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
