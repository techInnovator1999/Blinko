    "Turn it on to see coding agents and approve their requests here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere es, um Coding-Agents zu sehen und ihre Anfragen hier zu erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para ver los agentes de programación y aprobar sus solicitudes aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-le pour voir les agents de code et approuver leurs demandes ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、コーディングエージェントを確認し、ここでリクエストを承認できます。"
