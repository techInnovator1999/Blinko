    },
    "Updates are disabled in this development build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates sind in diesem Entwicklungs-Build deaktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones están desactivadas en esta versión de desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour sont désactivées dans cette version de développement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この開発ビルドではアップデートが無効になっています。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیولپمنٹ بلڈ میں اپ ڈیٹس غیر فعال ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此开发版本已停用更新。"
          }
        }
      }
    },
    "Used for the selected tab, progress bars, the scrubber and timers. Battery, camera and microphone keep their own colours. “Wallpaper” samples your desktop picture when you switch spaces or displays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den ausgewählten Tab, Fortschrittsbalken, die Zeitleiste und Timer. Batterie, Kamera und Mikrofon behalten ihre eigenen Farben. „Hintergrundbild“ übernimmt die Farbe deines Schreibtischbilds, wenn du Spaces oder Displays wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para la pestaña seleccionada, las barras de progreso, el control de reproducción y los temporizadores. La batería, la cámara y el micrófono mantienen sus propios colores. “Fondo de pantalla” toma muestras de tu imagen de escritorio al cambiar de espacio o de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée pour l’onglet sélectionné, les barres de progression, la tête de lecture et les minuteurs. La batterie, la caméra et le micro gardent leurs propres couleurs. « Fond d’écran » échantillonne l’image de votre bureau quand vous changez d’espace ou d’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択中のタブ、プログレスバー、スクラバー、タイマーに使用されます。バッテリー、カメラ、マイクは独自の色のままです。「壁紙」は、操作スペースやディスプレイを切り替えたときにデスクトップピクチャから色を取得します。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب ٹیب، پروگریس بارز، اسکربر اور ٹائمرز کے لیے استعمال ہوتا ہے۔ بیٹری، کیمرا اور مائیکروفون اپنے رنگ برقرار رکھتے ہیں۔ “وال پیپر” اسپیسز یا ڈسپلے بدلنے پر آپ کی ڈیسک ٹاپ تصویر سے رنگ لیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于选中的标签页、进度条、播放进度滑块和计时器。电池、相机和麦克风保留各自的颜色。“墙纸”会在你切换空间或显示器时取样你的桌面图片。"
          }
        }
      }
    },
    "Uses your approximate location once per session. You can pick a city in Settings instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet einmal pro Sitzung deinen ungefähren Standort. Du kannst stattdessen in den Einstellungen eine Stadt wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu ubicación aproximada una vez por sesión. Puedes elegir una ciudad en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise votre position approximative une fois par session. Vous pouvez plutôt choisir une ville dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションごとに1回、おおよその位置情報を使用します。代わりに設定で都市を選ぶこともできます。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر سیشن میں ایک بار آپ کا تخمینی مقام استعمال کرتا ہے۔ آپ اس کی بجائے سیٹنگز میں شہر چن سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次会话使用一次你的大致位置。你也可以改为在设置中选择城市。"
          }
        }
      }
    },
