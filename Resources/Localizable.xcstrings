    "Notes and snippets are saved in ~/Library/Application Support/Blinko. Keep Awake stops when Blinko quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen und Textbausteine werden in ~/Library/Application Support/Blinko gesichert. „Wach halten“ endet, wenn Blinko beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas y los fragmentos se guardan en ~/Library/Application Support/Blinko. Mantener activo se detiene al salir de Blinko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes et extraits sont enregistrés dans ~/Library/Application Support/Blinko. Garder éveillé s’arrête quand Blinko quitte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモとスニペットは ~/Library/Application Support/Blinko に保存されます。「スリープさせない」は Blinko を終了すると停止します。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نوٹس اور اسنیپٹس ~/Library/Application Support/Blinko میں محفوظ ہوتے ہیں۔ Blinko بند ہونے پر جاگتا رکھیں رک جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记和片段保存在 ~/Library/Application Support/Blinko 中。Blinko 退出时保持唤醒会停止。"
          }
        }
      }
    },
