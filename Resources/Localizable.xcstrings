    "A fast, native Dynamic Island for the Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine schnelle, native Dynamic Island für den Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una Dynamic Island rápida y nativa para Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une Dynamic Island native et rapide pour le Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac のための、高速でネイティブな Dynamic Island。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac کے لیے تیز، نیٹو ڈائنامک آئی لینڈ۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
