    "A theme sets the accent, style, size, corners and type. Export saves yours as a small JSON file to share or keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Theme legt Akzentfarbe, Stil, Größe, Ecken und Schrift fest. „Exportieren“ sichert deines als kleine JSON-Datei zum Teilen oder Aufbewahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tema define el acento, el estilo, el tamaño, las esquinas y la tipografía. Exportar guarda el tuyo como un pequeño archivo JSON para compartirlo o conservarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un thème définit la couleur d’accentuation, le style, la taille, les coins et la police. Exporter enregistre le vôtre dans un petit fichier JSON à partager ou à conserver."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマはアクセント、スタイル、サイズ、角、書体を設定します。書き出すと、共有や保存用の小さな JSON ファイルとして保存されます。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تھیم ایکسنٹ، انداز، سائز، کونے اور فونٹ طے کرتی ہے۔ ایکسپورٹ آپ کی تھیم کو شیئر کرنے یا محفوظ رکھنے کے لیے ایک چھوٹی JSON فائل میں محفوظ کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主题包含强调色、样式、尺寸、圆角和字体。导出会将你的主题存储为一个小型 JSON 文件，便于分享或保存。"
          }
        }
      }
    },
