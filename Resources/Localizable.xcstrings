    "Clear shelf" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ablage leeren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaciar estante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vider l’étagère"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルフを空にする"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شیلف صاف کریں"
          }
        },
        "zh-Hans" : {
