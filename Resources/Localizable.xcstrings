      }
    },
    "A long break follows every fourth focus session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jeder vierten Fokussitzung folgt eine lange Pause."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cuatro sesiones de concentración hay un descanso largo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une longue pause suit chaque quatrième session de concentration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中セッション4回ごとに長い休憩が入ります。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر چوتھے فوکس سیشن کے بعد طویل وقفہ آتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每完成四次专注后进行一次长休息。"
          }
        }
      }
    },
