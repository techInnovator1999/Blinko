    "In a Zoom, Teams, Meet, FaceTime or Slack call the island shows the call's length and your microphone. Mute or leave from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem Zoom-, Teams-, Meet-, FaceTime- oder Slack-Anruf zeigt die Insel die Anrufdauer und dein Mikrofon. Von dort stummschalten oder verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una llamada de Zoom, Teams, Meet, FaceTime o Slack, la isla muestra la duración de la llamada y tu micrófono. Silencia o sal desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un appel Zoom, Teams, Meet, FaceTime ou Slack, l’îlot affiche la durée de l’appel et votre micro. Activez la sourdine ou quittez l’appel depuis là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom、Teams、Meet、FaceTime、Slack の通話中は、アイランドに通話時間とマイクの状態が表示されます。そこからミュートや退出ができます。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom، Teams، Meet، FaceTime یا Slack کال میں آئی لینڈ کال کا دورانیہ اور آپ کا مائیکروفون دکھاتا ہے۔ وہیں سے میوٹ کریں یا کال چھوڑیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Zoom、Teams、Meet、FaceTime 或 Slack 通话中，灵动岛会显示通话时长和你的麦克风状态。可直接在此静音或离开。"
          }
        }
      }
    },
