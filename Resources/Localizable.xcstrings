    "Drag files onto the notch to park them on the Shelf. Drag them out again into any app, or send them with AirDrop in one click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh Dateien auf die Notch, um sie in der Ablage zu parken. Zieh sie wieder heraus in jede App oder sende sie mit einem Klick per AirDrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra archivos al notch para dejarlos en el Estante. Vuelve a arrastrarlos a cualquier app o envíalos por AirDrop con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des fichiers sur l’encoche pour les ranger sur l’Étagère. Faites-les glisser vers n’importe quelle app, ou envoyez-les avec AirDrop en un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをノッチにドラッグすると、シェルフに置いておけます。そこから任意のアプリにドラッグして取り出したり、ワンクリックで AirDrop で送信したりできます。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فائلوں کو شیلف پر رکھنے کے لیے انہیں نوچ پر گھسیٹیں۔ انہیں کسی بھی ایپ میں واپس گھسیٹیں، یا ایک کلک میں AirDrop سے بھیجیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拖到刘海上，即可存放到文件架。之后可将它们拖到任意应用中，或一键通过隔空投送发送。"
          }
        }
      }
    },
    "Drag out anywhere" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überallhin herausziehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrástralos a cualquier sitio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez-les où vous voulez"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこへでもドラッグ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کہیں بھی گھسیٹ کر نکالیں"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖到任意位置"
          }
        }
      }
    },
    "Drag to reorder. At least one tab stays visible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Neuordnen ziehen. Mindestens ein Tab bleibt sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Al menos una pestaña permanece visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Au moins un onglet reste visible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで並べ替え。少なくとも1つのタブは表示されたままになります。"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتیب بدلنے کے لیے گھسیٹیں۔ کم از کم ایک ٹیب نظر آتا رہے گا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以重新排序。至少保留一个可见的标签页。"
          }
        }
      }
    },
